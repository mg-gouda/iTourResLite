# Postgres
POSTGRES_USER=itour
POSTGRES_PASSWORD=changeme
POSTGRES_DB=itour
POSTGRES_HOST_PORT=5432

# Prisma / API
DATABASE_URL=postgresql://itour:changeme@localhost:5432/itour?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-secret   # generate: openssl rand -hex 64
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false   # set to true in production (HTTPS)

# API
API_PORT=4000
CORS_ORIGIN=http://localhost:3000   # production: https://fulvago.itmseg.cloud

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1   # production: https://fulvago.itmseg.cloud/api/v1
