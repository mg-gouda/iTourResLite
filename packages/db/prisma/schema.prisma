// iTour Reservation App — data model (see iTourResLite.md §4)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Role is internal-only; not admin-editable, kept as enum.
enum Role {
  ADMIN
  MANAGER
  AGENT
  ACCOUNTANT
  VIEWER
}

// ---- Admin-editable lookup tables (all 9 via System Parameters) ----

model BookingStatusLookup {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model RoomCategoryLookup {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model MealBasisLookup {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model PaymentMethodLookup {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model CurrencyLookup {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model SpoLookup {
  id        String  @id @default(cuid())
  code      String  @unique
  label     String?
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(VIEWER)
  active            Boolean   @default(true)
  lastLoginAt       DateTime?
  twoFactorSecret   String?
  twoFactorEnabled  Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bookings          Booking[]  @relation("CreatedBy")
  auditLogs         AuditLog[]
  userPermissions   UserPermission[]
}

model RolePermission {
  role       Role
  permission String
  granted    Boolean
  @@id([role, permission])
}

model UserPermission {
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  granted    Boolean
  @@id([userId, permission])
}

model TourOperator {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String?
  active   Boolean   @default(true)
  bookings Booking[]
}

model Market {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String?
  active   Boolean   @default(true)
  bookings Booking[]
}

model Resort {
  id       String    @id @default(cuid())
  code     String    @unique
  name     String?
  active   Boolean   @default(true)
  hotels   Hotel[]
  bookings Booking[]
}

model Hotel {
  id        String          @id @default(cuid())
  name      String          @unique
  email     String?
  resortId  String?
  resort    Resort?         @relation(fields: [resortId], references: [id])
  active    Boolean         @default(true)
  roomTypes HotelRoomType[]
  bookings  Booking[]
  stopSales StopSale[]
}

model HotelRoomType {
  id         String     @id @default(cuid())
  hotelId    String
  hotel      Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  name       String
  allocation Int        @default(0)
  active     Boolean    @default(true)
  bookings   Booking[]
  stopSales  StopSale[]

  @@unique([hotelId, name])
}

model Booking {
  id               String        @id @default(cuid())
  internalRef      String?       @unique  // 7-digit auto-generated on create
  bookingDate      DateTime
  hotelStatus      String        // BookingStatusLookup.code
  toStatus         String        // BookingStatusLookup.code
  tourOperatorId   String
  tourOperator     TourOperator  @relation(fields: [tourOperatorId], references: [id])
  marketId         String
  market           Market        @relation(fields: [marketId], references: [id])
  toBookingRef     String
  sejourRef        String?
  fileNumber       String?       // Local Market file ref e.g. FT-1001-01
  resortId         String
  resort           Resort        @relation(fields: [resortId], references: [id])
  hotelId          String
  hotel            Hotel         @relation(fields: [hotelId], references: [id])
  hotelRoomTypeId  String
  hotelRoomType    HotelRoomType @relation(fields: [hotelRoomTypeId], references: [id])
  arrivalDate      DateTime
  departureDate    DateTime
  roomCategory     String        // RoomCategoryLookup.code
  numRooms         Int
  adults           Int           @default(0)
  children         Int           @default(0)
  infants          Int           @default(0)
  mealBasis        String        // MealBasisLookup.code
  guestNames       String?       // legacy plain text; replaced by GuestName rows
  child1Age        Int?
  child1Dob        DateTime?
  child2Age        Int?
  child2Dob        DateTime?
  infantAge        Int?
  infantDob        DateTime?
  bookingCurrency  String?       // primary currency: USD | EUR | EGP | GBP
  guestNameList    GuestName[]
  costUsd          Decimal       @default(0) @db.Decimal(12, 2)
  sellingUsd       Decimal       @default(0) @db.Decimal(12, 2)
  calculationUsd   String?
  // plUsd derived = sellingUsd - costUsd
  costEur          Decimal       @default(0) @db.Decimal(12, 2)
  sellingEur       Decimal       @default(0) @db.Decimal(12, 2)
  calculationEur   String?
  // plEur derived = (sellingEur - costEur) + visaHandling
  costEgp          Decimal       @default(0) @db.Decimal(12, 2)
  sellingEgp       Decimal       @default(0) @db.Decimal(12, 2)
  calculationEgp   String?
  // plEgp derived = sellingEgp - costEgp
  paymentMethod    String        // PaymentMethodLookup.code
  paymentOptionDate DateTime?
  visaHandling     Decimal       @default(0) @db.Decimal(12, 2)
  // Finance: marked paid by Accountant/Manager. paidDate captured server-side
  // the moment bookingPaid flips false→true; cleared when unchecked.
  bookingPaid      Boolean       @default(false)
  paidDate         DateTime?
  paymentProofPath String?
  paymentProofName String?
  arrFlightNo      String?
  arrFlightTime    String?
  depFlightNo      String?
  depFlightTime    String?
  meetAssistVisa   String?
  remarks          String?
  ebdPercent       Decimal       @default(0) @db.Decimal(6, 4) // fraction; 0.05 = 5%
  ebdPaymentDate   DateTime?
  // ebdAmountUsd derived = ebdPercent * costUsd
  // ebdAmountEur derived = ebdPercent * costEur
  // ebdAmountEgp derived = ebdPercent * costEgp
  guestNameRebooked String?
  hotelRemarks     String?
  hasSpo           Boolean   @default(false)
  sejourSpoCode    String?
  spoDate          DateTime?
  roomCatsJson     String?   // JSON array of per-room categories when numRooms > 1
  rateHistoryJson  String?   // JSON array of RateChangeEntry; appended when cost decreases
  spoDocumentPath  String?
  spoDocumentName  String?
  createdById      String?
  createdBy        User?         @relation("CreatedBy", fields: [createdById], references: [id])
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([toBookingRef])
  @@index([hotelId, arrivalDate, departureDate])
  @@index([hotelRoomTypeId])
  @@index([hotelStatus])
}

model GuestName {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  title     String   @default("Mr")
  name      String
  type      String   @default("HOTEL")  // HOTEL | REBOOK
  room      Int      @default(1)
  sortOrder Int      @default(0)
  @@index([bookingId])
}

model StopSale {
  id              String         @id @default(cuid())
  hotelId         String
  hotel           Hotel          @relation(fields: [hotelId], references: [id])
  hotelRoomTypeId String?
  hotelRoomType   HotelRoomType? @relation(fields: [hotelRoomTypeId], references: [id])
  qty             Int
  fromDate        DateTime
  toDate          DateTime
  createdAt       DateTime       @default(now())

  @@index([hotelId, fromDate, toDate])
}

// Key-value store for app-wide settings (e.g. companyName)
model SystemConfig {
  key       String @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // CREATE | UPDATE | DELETE
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
